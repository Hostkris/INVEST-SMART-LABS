{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "investment-lab-calculator",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 */2 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SNAPSHOT_STORE",
        "class_name": "SnapshotStore"
      }
    ]
  },
  "exports": {
    "SnapshotStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
